#!/bin/bash
qemu-system-aarch64 -smp 6 -m 2048 -cpu cortex-a76 -M virt -nographic \
 -drive if=pflash,format=raw,file=efi.img,readonly=on \
 -drive if=pflash,format=raw,file=varstore.img \
 -drive if=none,file=oracular-server-cloudimg-arm64.img,id=hd0 \
 -device virtio-blk-device,drive=hd0 \
 -netdev user,id=unet -device virtio-net-pci,netdev=unet
# -netdev type=tap,id=net0 -device virtio-net-device,netdev=net0
 
